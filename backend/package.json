{
  "name": "@bloxbot/backend",
  "version": "0.1.0",
  "description": "Hosted mobile companion backend for BloxBot",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "bloxbot",
    "backend",
    "mobile"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@bloxbot/contracts": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
