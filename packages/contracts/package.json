{
  "name": "@bloxbot/contracts",
  "version": "0.1.0",
  "description": "Shared API contracts for BloxBot desktop, backend, and mobile clients",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "bloxbot",
    "contracts",
    "schemas"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
